-- Rayfield Library Load
local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

-- Create UI Window
local Window = Rayfield:CreateWindow({
    Name = "RZ Hub • PV",
    LoadingTitle = "Gym Star Simulator",
    LoadingSubtitle = "By JustKondzio0"
})

-- UI Tabs
local AutoFarmTab = Window:CreateTab("Auto Farm")
local AutoRankTab = Window:CreateTab("Auto Rank")
local PotionsTab  = Window:CreateTab("Potions")
local MiscTab     = Window:CreateTab("Misc")

-- Global States & Variables
_G.AutoFarmEverything = false
_G.AutoRank = false

local EnabledFarms = {}
local StatCategories = {"Chest", "Back", "Legs", "Abs", "Arms", "Stamina"}
local CurrentFarmIndex = 1
local LastFarmSwitch = tick()

-- Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Msg = ReplicatedStorage:WaitForChild("Msg")
local RemoteEvent = Msg:WaitForChild("RemoteEvent")
local ClickRemote = Msg:WaitForChild("Click")

-- Equipment References
local Scene1 = workspace:WaitForChild("Scene"):WaitForChild("1"):WaitForChild("Training equipment")

local TrainingEquipment = {
    ["Chest"] = {
        Scene1:WaitForChild("卧推1"),
        Scene1:WaitForChild("卧推4"),
        Scene1:WaitForChild("卧推5"),
        Scene1:WaitForChild("卧推2")
    },
    ["Back"] = {
        Scene1:WaitForChild("拉力器3"),
        Scene1:WaitForChild("拉力器2"),
        Scene1:WaitForChild("拉力器1")
    },
    ["Legs"] = {
        Scene1:WaitForChild("腿部器械2"),
        Scene1:WaitForChild("腿部器械3"),
        Scene1:WaitForChild("腿部器械4")
    },
    ["Abs"] = {
        Scene1:WaitForChild("腹部卷腹4"),
        Scene1:WaitForChild("腹部卷腹2"),
        Scene1:WaitForChild("腹部卷腹3")
    },
    ["Arms"] = {
        Scene1:WaitForChild("手臂2"),
        Scene1:WaitForChild("手臂1"),
        Scene1:WaitForChild("手臂4")
    },
    ["Stamina"] = {
        Scene1:WaitForChild("耐力3"),
        Scene1:WaitForChild("耐力6"),
        Scene1:WaitForChild("耐力2"),
        Scene1:WaitForChild("耐力5")
    }
}

-- Helper Functions
local function StartTraining(equipmentList)
    ClickRemote:FireServer()
    task.wait(0.1)
    
    for _, equipment in ipairs(equipmentList) do
        RemoteEvent:FireServer("StartTrain", equipment)
    end
end

local function CreateFarmToggle(displayName, statKey)
    AutoFarmTab:CreateToggle({
        Name = displayName,
        CurrentState = false,
        Callback = function(Value)
            if Value then
                EnabledFarms[statKey] = TrainingEquipment[statKey]
                Rayfield:Notify({
                    Title = "Status",
                    Content = statKey .. " Farm: Enabled",
                    Duration = 3
                })
            else
                EnabledFarms[statKey] = nil
                Rayfield:Notify({
                    Title = "Status",
                    Content = statKey .. " Farm: Disabled",
                    Duration = 3
                })
            end
        end
    })
end

-- ==================== TAB: AUTO FARM ====================
AutoFarmTab:CreateParagraph({
    Title = "Important Information",
    Content = "If something breaks, please rejoin the game and reinject the script. The AutoFarm EVERYTHING feature cycles through all farms every 10 seconds. Warning: This feature may sometimes be buggy."
})

-- Create individual farm toggles
CreateFarmToggle("Chest Farm", "Chest")
CreateFarmToggle("Back Farm", "Back")
CreateFarmToggle("Legs Farm", "Legs")
CreateFarmToggle("Abs Farm", "Abs")
CreateFarmToggle("Arms Farm", "Arms")
CreateFarmToggle("Stamina Farm", "Stamina")

-- Cycle All Farms Toggle
AutoFarmTab:CreateToggle({
    Name = "AutoFarm EVERYTHING",
    CurrentState = false,
    Callback = function(Value)
        _G.AutoFarmEverything = Value
        if Value then
            CurrentFarmIndex = 1
            LastFarmSwitch = tick()
            Rayfield:Notify({ Title = "Status", Content = "AutoFarm EVERYTHING: Enabled", Duration = 3 })
        else
            Rayfield:Notify({ Title = "Status", Content = "AutoFarm EVERYTHING: Disabled", Duration = 3 })
        end
    end
})

