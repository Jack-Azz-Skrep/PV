AutoRankTab:CreateToggle({
    Name = "Auto Rank",
    CurrentState = false,
    Callback = function(Value)
        _G.AutoRank = Value
        Rayfield:Notify({
            Title = "Status",
            Content = "Auto Rank: " .. (Value and "Enabled" or "Disabled"),
            Duration = 3
        })
    end
})

