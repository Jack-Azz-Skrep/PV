-- ==================== MAIN LOOP ====================
task.spawn(function()
    while task.wait(0.5) do
        if _G.AutoFarmEverything then
            -- Switch through stats every 10 seconds
            if tick() - LastFarmSwitch > 10 then
                CurrentFarmIndex = CurrentFarmIndex + 1
                if CurrentFarmIndex > #StatCategories then
                    CurrentFarmIndex = 1
                end
                LastFarmSwitch = tick()
            end

            local currentStat = StatCategories[CurrentFarmIndex]
            if TrainingEquipment[currentStat] then
                StartTraining(TrainingEquipment[currentStat])
            end
        else
            -- Process specific active farm toggles
            for _, equipmentList in pairs(EnabledFarms) do
                StartTraining(equipmentList)
            end

            -- Process Auto Rank
            if _G.AutoRank then
                RemoteEvent:FireServer("修改记录", { "收藏通知", 1 })
            end
        end
    end
end)
